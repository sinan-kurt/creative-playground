---
import BaseLayout from '../../layouts/BaseLayout.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const projects=await getCollection('projects');return projects.map(project=>({params:{slug:project.id},props:{project}}))}
const {project}=Astro.props;const {Content}=await render(project);const d=project.data;
---
<BaseLayout title={`${d.title} — Sinan Kurt`} description={d.description}><article class="wrap max-w-4xl pt-12"><a href="/projects" class="text-sm font-semibold underline underline-offset-4">← Tüm projeler</a><header class="mt-8 rounded-[30px] p-8 sm:p-12" style={`background:${d.color};color:${d.ink}`}><p class="kicker">{d.eyebrow} / {d.year}</p><div class="text-8xl my-6" aria-hidden="true">{d.icon}</div><h1 class="display text-5xl sm:text-7xl font-bold">{d.title}</h1><p class="mt-4 text-lg max-w-xl">{d.description}</p><div class="flex gap-3 mt-7 flex-wrap">{d.live && <a class="pill pill-dark" href={d.live} target="_blank" rel="noopener noreferrer">Canlı projeyi aç ↗</a>}{d.github && <a class="pill pill-line" href={d.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}</div></header><div class="grid sm:grid-cols-3 gap-4 my-10"><div class="border-t border-ink pt-3"><p class="kicker muted">CATEGORY</p><p class="font-bold mt-2">{d.category}</p></div><div class="border-t border-ink pt-3"><p class="kicker muted">STATUS</p><p class="font-bold mt-2">{d.status}</p></div><div class="border-t border-ink pt-3"><p class="kicker muted">STACK</p><p class="font-bold mt-2">{d.stack.join(', ')}</p></div></div><div class="grid gap-8 sm:grid-cols-2 my-12"><section><p class="kicker muted">01 / THE IDEA</p><h2 class="display font-bold text-3xl my-3">Problem</h2><p class="leading-relaxed">{d.problem}</p></section><section><p class="kicker muted">02 / THE BUILD</p><h2 class="display font-bold text-3xl my-3">Çözüm</h2><p class="leading-relaxed">{d.solution}</p></section><section class="sm:col-span-2"><p class="kicker muted">03 / OUTCOME</p><h2 class="display font-bold text-3xl my-3">Sonuç</h2><p class="leading-relaxed">{d.outcome}</p></section></div><div class="prose max-w-none [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-7 [&_p]:mt-3 [&_p]:leading-relaxed"><Content/></div></article></BaseLayout>