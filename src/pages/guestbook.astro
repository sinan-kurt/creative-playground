---
// Ziyaretçi defteri: ana sayfadaki masada açılan defterin tam sayfa hali.
// Masanın koyu, sıcak atmosferini sürdürür; içerik ve form aynı bileşenden gelir.
import Notebook from '../components/Notebook.astro';
const title = 'Ziyaretçi Defteri — Sinan Kurt';
const description = 'Masadaki defter: uğradıysan iki satır bırak.';
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta name="theme-color" content="#0C0A12"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@500;600&display=swap"/>
<style is:global>
  html, body { margin: 0; min-height: 100%; color-scheme: dark; }
  body { background: radial-gradient(120% 80% at 50% 0%, #2A1C14 0%, #120D0B 55%, #0C0A12 100%); color: #F1E9DC; font-family: "Bricolage Grotesque", system-ui, sans-serif; }
  .gb-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; max-width: 960px; margin: 0 auto; padding: 20px max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px)); }
  .gb-bar a { color: inherit; text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; }
  .gb-name { display: flex; flex-direction: column; line-height: 1.15; }
  .gb-name b { font-size: 17px; }
  .gb-name span { font-size: 13px; color: #A99FB2; }
  .gb-back { font-size: 14px; color: #A99FB2; }
  .gb-back:hover { color: #F1E9DC; }
  a:focus-visible { outline: 2px solid #FFB347; outline-offset: 3px; border-radius: 6px; }
</style>
</head>
<body>
  <header class="gb-bar">
    <a class="gb-name" href="/"><b>Sinan Kurt</b><span>masadaki defter</span></a>
    <a class="gb-back" href="/">← Masaya dön</a>
  </header>
  <main>
    <Notebook mode="page" />
  </main>
</body>
</html>
