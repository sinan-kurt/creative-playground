---
import BaseLayout from '../layouts/BaseLayout.astro';
const url=import.meta.env.PUBLIC_SUPABASE_URL || '';
const key=import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<BaseLayout title="Ziyaretçi Defteri — Sinan Kurt"><section class="wrap max-w-3xl py-16 sm:py-20"><p class="kicker muted">THE GUESTBOOK / LEAVE A MARK</p><h1 class="display text-6xl sm:text-8xl font-bold mt-5">Bir iz bırak<span class="text-[#8b7ee0]"> ✳</span></h1><p class="text-lg mt-6 muted">Selam verebilir, bir projeyle ilgili görüşünü yazabilir ya da yalnızca uğradığını söyleyebilirsin. Mesajlar yayınlanmadan önce onaylanır.</p><div class="grid md:grid-cols-5 gap-7 mt-12"><form id="guest-form" class="md:col-span-3 bg-mint rounded-[28px] p-7 space-y-4"><h2 class="display text-3xl font-bold">Merhaba de 👋</h2><div><label for="name" class="text-sm font-semibold block mb-1">İsmin</label><input id="name" name="name" maxlength="40" minlength="2" required autocomplete="name" placeholder="Sen kimsin?" class="w-full rounded-xl bg-white px-4 py-3 border border-ink/15"/></div><div><label for="message" class="text-sm font-semibold block mb-1">Mesajın</label><textarea id="message" name="message" maxlength="400" minlength="3" required rows="5" placeholder="Bir şeyler yaz..." class="w-full rounded-xl bg-white px-4 py-3 border border-ink/15 resize-y"></textarea></div><div class="hidden" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div><button class="pill pill-dark w-full" id="send" type="submit">Mesajı gönder ↗</button><p role="status" aria-live="polite" id="form-status" class="text-sm"></p><p class="text-xs muted">Mesajın ve adın onaydan sonra herkese açık gösterilir. E-posta veya kişisel bilgi yazma.</p></form><aside class="md:col-span-2 rounded-[28px] bg-lilac p-7"><span class="text-6xl" aria-hidden="true">💬</span><h2 class="display text-3xl font-bold mt-7">Duvarda yerin var.</h2><p class="mt-4 text-sm">Defterin amacı etkileşim puanı toplamak değil; internetin küçük bir köşesinde samimi notlar biriktirmek.</p></aside></div><h2 class="display text-4xl font-bold mt-16">Bırakılan notlar.</h2><div id="messages" class="grid sm:grid-cols-2 gap-4 mt-7" aria-live="polite"><p class="muted">Mesajlar yükleniyor…</p></div></section>
<script define:vars={{url,key}}>
const api = url && key ? `${url.replace(/\/$/,'')}/rest/v1/guestbook_entries` : '';
const headers = {apikey:key,Authorization:`Bearer ${key}`};
const list=document.getElementById('messages');const form=document.getElementById('guest-form');const status=document.getElementById('form-status');
async function load(){if(!api){list.textContent='Ziyaretçi defteri henüz bağlanmadı. Supabase yapılandırması README dosyasında.';return;}try{const res=await fetch(`${api}?select=name,message,created_at&approved=eq.true&order=created_at.desc&limit=20`,{headers});if(!res.ok)throw Error('fetch');const data=await res.json();list.replaceChildren();if(!data.length){list.textContent='Henüz bir not yok. İlk mesajı sen bırak!';return;}for(const row of data){const card=document.createElement('article');card.className='rounded-3xl bg-white border border-ink/10 p-6';const name=document.createElement('strong');name.className='block mb-2';name.textContent=String(row.name).slice(0,40);const body=document.createElement('p');body.className='text-sm whitespace-pre-wrap break-words';body.textContent=String(row.message).slice(0,400);card.append(name,body);list.append(card);}}catch{list.textContent='Mesajlar şu anda yüklenemiyor.';}}
form.addEventListener('submit',async(e)=>{e.preventDefault();if(!api){status.textContent='Mesaj gönderimi için Supabase kurulumu gerekiyor.';return;}const fd=new FormData(form);if(fd.get('website'))return;const name=String(fd.get('name')||'').trim(),message=String(fd.get('message')||'').trim();if(name.length<2||name.length>40||message.length<3||message.length>400){status.textContent='İsim veya mesaj uzunluğu geçersiz.';return;}const btn=document.getElementById('send');btn.disabled=true;status.textContent='Gönderiliyor…';try{const res=await fetch(api,{method:'POST',headers:{...headers,'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify({name,message})});if(!res.ok)throw Error('insert');status.textContent='Mesajın alındı! Onaylandıktan sonra burada görünecek.';form.reset();}catch{status.textContent='Gönderilemedi. Biraz sonra tekrar deneyebilirsin.';}finally{btn.disabled=false;}});
load();
</script></BaseLayout>