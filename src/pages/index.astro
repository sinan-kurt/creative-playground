---
// Ana sayfa: "Deney Defteri" tasarımı. Diğer sayfalar BaseLayout'u kullanmaya devam ediyor.
const title = 'Sinan Kurt — Deney Defteri';
const description = 'Web uygulamaları, tarayıcı oyunları ve dijital deneyler. Her biri bir soruyla başlıyor.';
const ogImage = new URL('/og-image.png', Astro.site).toString();
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#EEF2E6" media="(prefers-color-scheme: light)"/>
<meta name="theme-color" content="#0F2B48" media="(prefers-color-scheme: dark)"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&family=Caveat:wght@500&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"/>
</head>
<body>
<style is:global>
/* Layout: mühendis defteri — kareli kâğıt, solda kırmızı kenar çizgisi, her proje bir deney kaydı (soru · durum · sonraki adım). Gece: mavi kopya (blueprint). */
:root {
  --paper: #EEF2E6;
  --grid: #DCE4D0;
  --card: #F8FAF3;
  --ink: #1E2F6B;
  --ink-soft: #46527A;
  --rule: #C6D1B8;
  --margin: #C93C33;
  --live: #2D7A47;
  --on-ink: #F8FAF3;
  --f-display: "Bricolage Grotesque", "Arial Narrow", system-ui, sans-serif;
  --f-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --f-hand: "Caveat", "Comic Sans MS", cursive;
  --cell: 24px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0F2B48; --grid: #18395C; --card: #13355A; --ink: #EAF2FB; --ink-soft: #AFC3DA;
    --rule: #2B5580; --margin: #FF8F80; --live: #74D392; --on-ink: #0F2B48; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #0F2B48; --grid: #18395C; --card: #13355A; --ink: #EAF2FB; --ink-soft: #AFC3DA;
  --rule: #2B5580; --margin: #FF8F80; --live: #74D392; --on-ink: #0F2B48; color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background-color: var(--paper);
  background-image:
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: var(--cell) var(--cell);
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 17px;
  line-height: 1.55;
  margin: 0;
}
a { color: inherit; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--margin); outline-offset: 3px; border-radius: 4px; }
h1, h2, h3 { font-family: var(--f-display); text-wrap: balance; margin: 0; letter-spacing: -0.02em; }
p { margin: 0; }

.page { max-width: 1080px; margin: 0 auto; padding-inline: 16px; padding-block: 0 64px; position: relative; }
@media (min-width: 760px) {
  .page { padding-inline: 72px 32px; }
  .page::before { content: ""; position: absolute; top: 0; bottom: 0; left: 48px; width: 2px; background: var(--margin); opacity: 0.55; }
}

.label { font-family: var(--f-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
.hand { font-family: var(--f-hand); font-size: 24px; line-height: 1.1; color: var(--margin); }

/* Üst bar */
.top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 20px; border-bottom: 1px solid var(--rule); }
.mark { font-family: var(--f-display); font-weight: 800; font-size: 22px; text-decoration: none; letter-spacing: -0.04em; }
.mark span { color: var(--margin); }
.nav { display: flex; gap: 4px 18px; flex-wrap: wrap; font-size: 15px; }
.nav a { text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
.nav a:hover { text-decoration: underline; text-underline-offset: 4px; }

/* Giriş */
.hero { display: grid; gap: 28px; padding-block: 56px 40px; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 900px) { .hero { grid-template-columns: minmax(0, 1fr) 240px; align-items: end; } }
.hero h1 { font-size: clamp(44px, 8vw, 88px); line-height: 0.95; font-weight: 800; font-variation-settings: "wdth" 85; }
.hero h1 em { font-style: normal; color: var(--margin); }
.hero .lead { margin-top: 22px; font-size: 20px; max-width: 34em; color: var(--ink-soft); }
.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
.btn { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border-radius: 999px; font-weight: 600; font-size: 15px; text-decoration: none; border: 1.5px solid var(--ink); }
.btn.solid { background: var(--ink); color: var(--on-ink); }
.btn:hover { transform: translateY(-1px); }
.side { display: flex; flex-direction: column; gap: 10px; }
.side .hand { transform: rotate(-3deg); }
.tally { font-family: var(--f-mono); font-size: 13px; color: var(--ink-soft); display: grid; gap: 4px; border-top: 1px dashed var(--rule); padding-top: 10px; font-variant-numeric: tabular-nums; }

/* Deney kayıtları */
.section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 2px solid var(--ink); margin-top: 24px; }
.section-head h2 { font-size: clamp(30px, 4.5vw, 44px); font-weight: 800; }
.entries { display: flex; flex-direction: column; }
.entry { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; padding-block: 36px; border-bottom: 1px solid var(--rule); }
@media (min-width: 820px) { .entry { grid-template-columns: 200px minmax(0, 1fr) 280px; gap: 32px; } }
@media (max-width: 819px) { .entry .body { order: -1; } }
.meta { display: flex; flex-direction: column; gap: 12px; }
.chip { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-family: var(--f-mono); font-size: 12.5px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--rule); background: var(--card); }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--live); }
.dot.wait { background: transparent; border: 1.5px dashed var(--ink-soft); }
.stack { font-family: var(--f-mono); font-size: 12.5px; color: var(--ink-soft); line-height: 1.7; }
.body h3 { font-size: 32px; font-weight: 800; line-height: 1.05; }
.q { margin-top: 12px; font-size: 19px; font-weight: 500; }
.q::before { content: "Soru: "; font-family: var(--f-mono); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--margin); font-weight: 400; }
.desc { margin-top: 10px; color: var(--ink-soft); max-width: 36em; }
.next { margin-top: 14px; font-size: 15px; color: var(--ink-soft); display: flex; gap: 8px; }
.next b { font-family: var(--f-mono); font-weight: 500; font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); white-space: nowrap; padding-top: 2px; }
.go { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; min-height: 44px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
.go:hover { color: var(--margin); }
.soon { margin-top: 18px; font-size: 15px; color: var(--ink-soft); }

/* Her kaydın kendi çizimi */
.fig { background: var(--card); border: 1px solid var(--rule); border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 10px; align-self: start; max-width: 100%; }
.fig .label { font-size: 11px; }
.diff-wrap { overflow-x: auto; }
.diff { width: 100%; border-collapse: collapse; font-family: var(--f-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
.diff th { text-align: left; font-weight: 500; color: var(--ink-soft); padding: 4px 6px 6px 0; border-bottom: 1px solid var(--rule); }
.diff td { padding: 6px 6px 6px 0; border-bottom: 1px dashed var(--rule); white-space: nowrap; }
.diff td:last-child, .diff th:last-child { text-align: right; padding-right: 0; }
.up { color: var(--margin); font-weight: 500; }
.gone { text-decoration: line-through; color: var(--ink-soft); }
.tiles { display: flex; gap: 6px; }
.tile { width: 40px; height: 44px; display: grid; place-items: center; font-family: var(--f-display); font-weight: 800; font-size: 22px; border: 1.5px solid var(--ink); border-radius: 4px; background: var(--paper); }
.tile.blank { border-style: dashed; color: var(--ink-soft); }
.tea { display: flex; align-items: flex-end; gap: 14px; }
.tea svg { width: 64px; height: 96px; flex-shrink: 0; }
.steam path { animation: rise 3.2s ease-in-out infinite; }
.steam path:nth-child(2) { animation-delay: 0.8s; }
@keyframes rise { 0%, 100% { opacity: 0.35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
@media (prefers-reduced-motion: reduce) { .steam path { animation: none; } .btn:hover { transform: none; } }

/* Alt bölümler */
.duo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 56px; }
@media (min-width: 820px) { .duo { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.panel { background: var(--card); border: 1px solid var(--rule); border-radius: 6px; padding: 24px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.panel h2 { font-size: 28px; font-weight: 800; }
.list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.list li { display: flex; gap: 10px; }
.list li::before { content: "→"; color: var(--margin); font-family: var(--f-mono); }
.tools { display: flex; flex-wrap: wrap; gap: 6px; }
.tools span { font-family: var(--f-mono); font-size: 12.5px; padding: 3px 9px; border: 1px solid var(--rule); border-radius: 999px; }

.contact { margin-top: 56px; padding-block: 40px; border-top: 2px solid var(--ink); display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 820px) { .contact { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
.contact h2 { font-size: clamp(34px, 5.5vw, 56px); font-weight: 800; line-height: 1; }
.contact p { margin-top: 12px; color: var(--ink-soft); max-width: 32em; }
.links { display: flex; gap: 12px; flex-wrap: wrap; }
footer { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 20px; border-top: 1px solid var(--rule); font-family: var(--f-mono); font-size: 12.5px; color: var(--ink-soft); }
</style>

<div class="page">
  <header class="top">
    <a class="mark" href="#">sk<span>.</span></a>
    <nav class="nav" aria-label="Sayfa içi">
      <a href="#deneyler">Deneyler</a>
      <a href="#simdi">Şu an</a>
      <a href="#hakkimda">Hakkımda</a>
      <a href="#iletisim">İletişim</a>
    </nav>
  </header>

  <section class="hero">
    <div>
      <p class="label">Deney defteri · İstanbul · 2026</p>
      <h1 style="margin-top:14px">Hey, ben Sinan.<br>İnternette <em>küçük şeyler</em> yapıyorum.</h1>
      <p class="lead">Web uygulamaları, tarayıcı oyunları ve kimse istemese de yapmak istediğim fikirler. Her biri bir soruyla başlıyor. Burada hepsinin kaydı var.</p>
      <div class="actions">
        <a class="btn solid" href="#deneyler">Deneylere bak ↓</a>
        
        <a class="btn" href="https://instagram.com/sina.hustle">Instagram'da süreç ↗</a>
      </div>
    </div>
    <aside class="side" aria-label="Özet">
      <p class="hand">fikirlere açığım ✳</p>
      <div class="tally">
        <span>3 deney kayıtlı</span>
        <span>2 tanesi canlı, denenebilir</span>
        <span>1 tanesi masada</span>
      </div>
    </aside>
  </section>

  <section id="deneyler" aria-labelledby="deneyler-baslik">
    <div class="section-head">
      <h2 id="deneyler-baslik">Deneyler</h2>
      <span class="label">soru → prototip → ürün</span>
    </div>

    <div class="entries">
      <article class="entry">
        <div class="meta">
          <span class="label">Ürün · SaaS</span>
          <span class="chip"><span class="dot"></span>MVP canlı</span>
          <span class="stack">Next.js<br>TypeScript<br>Supabase</span>
        </div>
        <div class="body">
          <h3>MetrajOS</h3>
          <p class="q">İki metraj revizyonu arasında ne değişti ve bu maliyete nasıl yansıdı?</p>
          <p class="desc">İki Excel metraj dosyasını karşılaştırıyor. Eklenen, silinen ve miktarı değişen satırları işaretliyor, maliyet etkisini görünür yapıyor. Revizyon farklarını elle takip etmek hem yavaş hem riskli.</p>
          <p class="next"><b>Sonraki</b>Gerçek şantiye dosyalarıyla doğrulamak.</p>
          <a class="go" href="https://metrajos.vercel.app/">Siteyi dene ↗</a>
        </div>
        <figure class="fig" style="margin:0">
          <span class="label">Rev A → Rev B · örnek veri</span>
          <div class="diff-wrap">
            <table class="diff">
              <thead><tr><th>Kalem</th><th>Fark</th></tr></thead>
              <tbody>
                <tr><td>C30/37 beton</td><td class="up">+8,5 m³</td></tr>
                <tr><td>Ø12 donatı</td><td>—</td></tr>
                <tr><td class="gone">Alçı sıva</td><td>silindi</td></tr>
                <tr><td>Seramik kaplama</td><td class="up">yeni · 85 m²</td></tr>
              </tbody>
            </table>
          </div>
        </figure>
      </article>

      <article class="entry">
        <div class="meta">
          <span class="label">Oyun · Tarayıcı</span>
          <span class="chip"><span class="dot"></span>Oynanabilir</span>
          <span class="stack">JavaScript<br>HTML / CSS<br>Oyun tasarımı</span>
        </div>
        <div class="body">
          <h3>Mola Oyunları</h3>
          <p class="q">Çay ocağı ve dolmuş durağı küçük bir oyun döngüsüne dönüşür mü?</p>
          <p class="desc">Türkiye'de gündelik hayattan çıkan, birkaç dakikalık tarayıcı oyunları. Tanıdık sahneler, basit kurallar, bir mola uzunluğunda oyun.</p>
          <p class="next"><b>Sonraki</b>Oyuncu geri bildirimiyle bölümleri ve akışı iyileştirmek.</p>
          <a class="go" href="https://sinan-kurt.github.io/herdilabs-play/">Hemen oyna ↗</a>
        </div>
        <figure class="fig" style="margin:0">
          <span class="label">Bölüm 1 · çay ocağı</span>
          <div class="tea">
            <svg viewBox="0 0 64 96" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <g class="steam"><path d="M26 14c-4-4 4-7 0-11"></path><path d="M38 14c-4-4 4-7 0-11"></path></g>
              <path d="M14 26h36l-6 22c-1 4-1 6 1 9l3 8c2 6-2 11-8 11H24c-6 0-10-5-8-11l3-8c2-3 2-5 1-9z" fill="var(--paper)"></path>
              <path d="M18 40h28l-3 9c-1 3-1 5 1 8l2 6c1 4-1 7-5 7H23c-4 0-6-3-5-7l2-6c2-3 2-5 1-8z" fill="var(--margin)" stroke="none" opacity="0.85"></path>
              <path d="M8 88h48"></path>
            </svg>
            <p class="hand" style="font-size:21px">ince belli,<br>tavşan kanı</p>
          </div>
        </figure>
      </article>

      <article class="entry">
        <div class="meta">
          <span class="label">Deney · Etkileşimli</span>
          <span class="chip"><span class="dot wait"></span>Yakında</span>
          <span class="stack">Next.js<br>TypeScript<br>Supabase</span>
        </div>
        <div class="body">
          <h3>Sevgili Bulmacası</h3>
          <p class="q">Sevdiğin birine mesaj yerine bulmaca göndermek daha güzel olmaz mı?</p>
          <p class="desc">Kendi bulmacanı hazırlıyorsun, sistem ona göre bir ızgara kuruyor, sen de linki gönderiyorsun. Karşı taraf çözdükçe mesaj ortaya çıkıyor.</p>
          <p class="next"><b>Sonraki</b>Oynanabilir MVP hazır. Son kontrollerden sonra yayında.</p>
          <p class="soon">Açıldığında ilk Instagram'da duyuracağım.</p>
        </div>
        <figure class="fig" style="margin:0">
          <span class="label">Harfleri tamamla</span>
          <div class="tiles" aria-label="Örnek bulmaca: S E V ve iki boş kare">
            <span class="tile">S</span><span class="tile">E</span><span class="tile">V</span><span class="tile blank">?</span><span class="tile blank">?</span>
          </div>
          <p class="hand" style="font-size:20px">ipucu: bu sayfada yazıyor</p>
        </figure>
      </article>
    </div>
  </section>

  <div class="duo">
    <section class="panel" id="simdi" aria-labelledby="simdi-baslik">
      <span class="label">Ekim 2026</span>
      <h2 id="simdi-baslik">Şu an masamda</h2>
      <ul class="list">
        <li>Mola Oyunları'na yeni bölümler ve daha akıcı bir oyun akışı</li>
        <li>Sevgili Bulmacası'nı yayına hazırlamak</li>
        <li>Bu defteri büyütmek: her yeni deney buraya bir kayıt olarak ekleniyor</li>
      </ul>
    </section>

    <section class="panel" id="hakkimda" aria-labelledby="hakkimda-baslik">
      <span class="label">Hakkımda</span>
      <h2 id="hakkimda-baslik">Fikri düşünmekle kalmıyorum</h2>
      <p>İstanbul'da yazılım, ürün ve tasarımın kesiştiği yerde çalışıyorum. Fikirleri çalışan ürünlere çevirmeyi seviyorum. Yaratıcı ajans <strong>Offra Studio</strong>'nun da kurucu ortaklarındanım: kimlik tasarımı, yaratıcı strateji ve dijital deneyimler.</p>
      <div class="tools" aria-label="Kullandığım araçlar">
        <span>TypeScript</span><span>JavaScript</span><span>Next.js</span><span>Astro</span><span>Tailwind</span><span>Supabase</span><span>SQL</span><span>Unity</span>
      </div>
    </section>
  </div>

  <section class="contact" id="iletisim" aria-labelledby="iletisim-baslik">
    <div>
      <h2 id="iletisim-baslik">Bir fikrin mi var?</h2>
      <p>Birlikte bir şey yapmak, bir deneyi konuşmak ya da sadece selam vermek için yaz. Süreci en sık Instagram'da paylaşıyorum.</p>
    </div>
    <div class="links">
      <a class="btn solid" href="https://instagram.com/sina.hustle">Instagram ↗</a>
      <a class="btn" href="https://github.com/sinan-kurt">GitHub ↗</a>
      <a class="btn" href="/guestbook">Deftere not bırak ↗</a>
    </div>
  </section>

  <footer>
    <span>© 2026 Sinan Kurt</span>
    <span>merakla yapıldı ✳</span>
  </footer>
</div>


<div id="secret" role="status" aria-live="polite" hidden style="position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:50;max-width:300px;padding:16px 18px;border-radius:6px;background:var(--ink);color:var(--on-ink);font-size:15px;box-shadow:0 12px 32px rgba(0,0,0,.25)">Gizli kaydı buldun ✳ Defterin ilk sayfasına bir not bırakmayı unutma.</div>
<script is:inline>
(function(){var seq="sinan",i=0;document.addEventListener("keydown",function(e){if(e.key&&e.key.toLowerCase()===seq[i]){i++;if(i===seq.length){i=0;var el=document.getElementById("secret");if(el){el.hidden=false;setTimeout(function(){el.hidden=true;},5000);}}}else{i=e.key&&e.key.toLowerCase()===seq[0]?1:0;}});})();
</script>
</body>
</html>
