<div class="toast" id="secret" role="status" aria-live="polite" hidden>Gizli kaydı buldun ✳ Defterime bir not bırakmayı unutma.</div>

<script is:inline>
(function () {
  var colors = ["#2E3FE0", "#FF6A2B", "#E2337F", "#1E9E6E", "#FFF8EC", "#17120F"];
  var glyphs = ["✳", "★", "●", "♥", "✦", "▲", "☺"];
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var hero = document.getElementById("hero");
  if (hero) {
    hero.addEventListener("click", function (e) {
      if (e.target.closest("a, button")) return;
      var r = hero.getBoundingClientRect();
      var s = document.createElement("span");
      s.className = "pop";
      s.setAttribute("aria-hidden", "true");
      s.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
      s.style.left = (e.clientX - r.left - 16) + "px";
      s.style.top = (e.clientY - r.top - 18) + "px";
      s.style.color = colors[Math.floor(Math.random() * colors.length)];
      s.style.fontSize = (26 + Math.random() * 40) + "px";
      s.style.setProperty("--r", (Math.random() * 60 - 30) + "deg");
      hero.appendChild(s);
      var pops = hero.querySelectorAll(".pop");
      if (pops.length > 40) pops[0].remove();
    });
  }

  var desk = document.getElementById("desk");
  var wide = window.matchMedia("(min-width: 900px)");
  var top = 10;
  if (desk) {
    var objs = Array.prototype.slice.call(desk.querySelectorAll(".obj"));
    objs.forEach(function (el) {
      el.dataset.r0 = getComputedStyle(el).getPropertyValue("--r").trim() || "0deg";
      var sx, sy, bx, by, moved = false, active = false;
      el.addEventListener("pointerdown", function (e) {
        if (!wide.matches || e.button !== 0) return;
        active = true; moved = false;
        sx = e.clientX; sy = e.clientY;
        bx = parseFloat(el.style.getPropertyValue("--dx")) || 0;
        by = parseFloat(el.style.getPropertyValue("--dy")) || 0;
        el.classList.remove("settle");
        el.style.zIndex = ++top;
      });
      window.addEventListener("pointermove", function (e) {
        if (!active) return;
        var dx = e.clientX - sx, dy = e.clientY - sy;
        if (!moved && Math.abs(dx) + Math.abs(dy) < 6) return;
        if (!moved) { moved = true; el.classList.add("dragging"); try { el.setPointerCapture(e.pointerId); } catch (err) {} }
        el.style.setProperty("--dx", (bx + dx) + "px");
        el.style.setProperty("--dy", (by + dy) + "px");
      });
      window.addEventListener("pointerup", function () {
        if (!active) return;
        active = false;
        el.classList.remove("dragging");
      });
      el.addEventListener("click", function (e) {
        if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
      }, true);
    });

    var shuffle = document.getElementById("shuffle");
    var tidy = document.getElementById("tidy");
    if (shuffle) shuffle.addEventListener("click", function () {
      objs.forEach(function (el) {
        if (!reduce) el.classList.add("settle");
        if (wide.matches) {
          el.style.setProperty("--dx", Math.round(Math.random() * 160 - 80) + "px");
          el.style.setProperty("--dy", Math.round(Math.random() * 120 - 60) + "px");
          el.style.zIndex = ++top;
        }
        el.style.setProperty("--r", Math.round(Math.random() * 24 - 12) + "deg");
      });
    });
    if (tidy) tidy.addEventListener("click", function () {
      objs.forEach(function (el) {
        if (!reduce) el.classList.add("settle");
        el.style.setProperty("--dx", "0px");
        el.style.setProperty("--dy", "0px");
        el.style.setProperty("--r", "0deg");
      });
    });
  }

  var seq = "sinan", i = 0;
  document.addEventListener("keydown", function (e) {
    var k = e.key ? e.key.toLowerCase() : "";
    if (k === seq[i]) {
      i++;
      if (i === seq.length) {
        i = 0;
        var el = document.getElementById("secret");
        if (el) { el.hidden = false; setTimeout(function () { el.hidden = true; }, 5000); }
      }
    } else { i = k === seq[0] ? 1 : 0; }
  });
})();
</script>

