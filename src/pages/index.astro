---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import { getCollection } from 'astro:content';
const projects=(await getCollection('projects')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.year-a.data.year);
---
<BaseLayout><section class="wrap pt-12 sm:pt-20 pb-10"><div class="flex items-center gap-3 mb-8"><span class="bg-mint rounded-full px-4 py-2 kicker">✳ OPEN TO IDEAS</span><span class="kicker muted">ISTANBUL, TR</span></div><div class="max-w-4xl"><h1 class="display text-[clamp(3.5rem,9vw,7.8rem)] leading-[.99] font-bold">Hey, ben Sinan<span class="text-[#8b7ee0]"> ✳</span><br/>İnternette bir şeyler yapıyorum.</h1><p class="mt-7 text-lg sm:text-xl text-ink/70 max-w-2xl leading-relaxed">Web uygulamaları, küçük oyunlar ve bazen kimsenin istemediği ama benim yapmak istediğim fikirler.</p><div class="flex flex-wrap gap-3 mt-8"><a class="pill pill-dark" href="#projects">İşlerime bak ↓</a><a class="pill pill-line" href="/about">Ben kimim? ↗</a></div></div><div class="mt-12 sm:mt-16 relative min-h-[160px] rounded-[28px] bg-lilac overflow-hidden flex items-center justify-between px-7 sm:px-12"><div><p class="kicker">IDEAS → THINGS</p><p class="display text-3xl sm:text-5xl font-bold mt-2">A little bit of everything.</p></div><span aria-hidden="true" class="floaty text-8xl sm:text-[130px]">✳</span></div></section>
<ProjectGallery projects={projects}/><section class="wrap grid md:grid-cols-2 gap-4 mb-10"><div class="rounded-[28px] bg-ink text-white p-8 sm:p-10"><p class="kicker text-mint">WHAT I'M UP TO</p><h2 class="display text-4xl font-bold mt-4">Şu an ne yapıyorum?</h2><p class="text-white/70 my-5">Mini web oyunları, yeni ürün fikirleri ve bu dijital oyun alanını geliştirmekle ilgileniyorum.</p><a href="/now" class="underline underline-offset-4 text-mint font-semibold">Güncel notlarım ↗</a></div><div class="rounded-[28px] bg-peach p-8 sm:p-10"><p class="kicker">LEAVE A MARK</p><h2 class="display text-4xl font-bold mt-4">Bir şey söylemek ister misin?</h2><p class="my-5 text-ink/70">Siteden geçen herkes küçük bir iz bırakabilir. Ziyaretçi defteri seni bekliyor.</p><a href="/guestbook" class="underline underline-offset-4 font-semibold">Deftere git ↗</a></div></section><div id="secret" role="status" aria-live="polite" class="fixed bottom-6 right-6 hidden z-50 rounded-2xl bg-ink text-white shadow-2xl p-5 max-w-xs">🎉 Gizli bölümü buldun! Bir sonraki ipucu: klavyede <b>S I N A N</b> yazmak her zaman işe yarar.</div><script>document.addEventListener('playground:secret',()=>{const el=document.getElementById('secret');el?.classList.remove('hidden');setTimeout(()=>el?.classList.add('hidden'),5000)});</script></BaseLayout>