---
// Ana sayfa: "Sinan'ın masası" — renkli, dağınık, sürüklenebilir. Diğer sayfalar BaseLayout'u kullanıyor.
const title = 'Sinan Kurt — İnternette küçük, garip, renkli şeyler';
const description = 'Web uygulamaları, tarayıcı oyunları ve dijital deneyler. Hepsi masamın üstünde.';
const ogImage = new URL('/og-image.png', Astro.site).toString();
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#FFD23F"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@500&family=JetBrains+Mono:wght@400;500;700&family=Rubik+Mono+One&family=Shrikhand&display=swap"/>
</head>
<body>
<style is:global>
/* Layout: Sinan'ın masası. Renkli bantlar üst üste; ortada projeler masaya saçılmış nesneler (fiş, oyun kutusu, zarf, kartvizit, yapışkan not, etiket bandı), masaüstünde sürüklenebilir. */
:root {
  --ink: #17120F;
  --paper: #FFF8EC;
  --sun: #FFD23F;
  --cobalt: #2E3FE0;
  --tangerine: #FF6A2B;
  --bubblegum: #FF8CC6;
  --lime: #C6F25A;
  --mint: #7FE3C4;
  --f-display: "Shrikhand", "Cooper Black", Georgia, serif;
  --f-stamp: "Rubik Mono One", "Arial Black", Impact, sans-serif;
  --f-body: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
  --f-hand: "Caveat", "Comic Sans MS", cursive;
  color-scheme: light;
}
* { box-sizing: border-box; }
html { background: var(--sun); overflow-x: clip; }
body { margin: 0; background: var(--sun); color: var(--ink); font-family: var(--f-body); font-size: 17px; line-height: 1.5; overflow-x: clip; }
a { color: inherit; }
p { margin: 0; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
a:focus-visible, button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
.wrap { max-width: 1200px; margin: 0 auto; padding-inline: 16px; }
@media (min-width: 760px) { .wrap { padding-inline: 32px; } }
.stamp { font-family: var(--f-stamp); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }
.hand { font-family: var(--f-hand); font-weight: 500; }

/* ---------- üst ---------- */
.top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-block: 18px; }
.logo { font-family: var(--f-display); font-size: 30px; text-decoration: none; transform: rotate(-4deg); display: inline-block; }
.nav { display: flex; gap: 8px; flex-wrap: wrap; }
.nav a { font-family: var(--f-stamp); font-size: 11px; text-transform: uppercase; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; padding: 0 14px; border: 2px solid var(--ink); border-radius: 999px; background: var(--paper); transition: transform 0.15s; }
.nav a:nth-child(1) { background: var(--bubblegum); transform: rotate(-3deg); }
.nav a:nth-child(2) { background: var(--lime); transform: rotate(2deg); }
.nav a:nth-child(3) { background: var(--mint); transform: rotate(-1deg); }
.nav a:nth-child(4) { background: var(--paper); transform: rotate(3deg); }
.nav a:hover { transform: rotate(0) scale(1.08); }

/* ---------- giriş ---------- */
.hero { position: relative; padding-block: 40px 88px; cursor: crosshair; }
.hero h1 { font-family: var(--f-display); font-weight: 400; font-size: clamp(52px, 10.5vw, 138px); line-height: 0.92; letter-spacing: -0.01em; position: relative; z-index: 2; }
.hero h1 .l { display: inline-block; transition: transform 0.2s cubic-bezier(.3,1.6,.5,1); }
.hero h1 .l:hover { transform: translateY(-10px) rotate(-8deg); }
.c1 { color: var(--cobalt); } .c2 { color: var(--tangerine); } .c3 { color: #E2337F; } .c4 { color: #1E9E6E; }
.hero .line2 { display: block; font-size: 0.52em; margin-top: 10px; color: var(--ink); }
.boxed { display: inline-block; background: var(--cobalt); color: var(--sun); padding: 0 0.18em; transform: rotate(-3deg); border-radius: 6px; }
.scrawl { font-family: var(--f-hand); color: #E2337F; font-size: 1.15em; display: inline-block; transform: rotate(4deg); }
.hero .lead { margin-top: 28px; max-width: 30em; font-size: 20px; position: relative; z-index: 2; }
.hero .lead mark { background: var(--paper); padding: 0 6px; border-radius: 4px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.hero .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; position: relative; z-index: 2; }
.btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 22px; border: 2.5px solid var(--ink); border-radius: 999px; font-weight: 700; font-size: 16px; text-decoration: none; background: var(--paper); box-shadow: 4px 4px 0 var(--ink); transition: transform 0.12s, box-shadow 0.12s; cursor: pointer; font-family: var(--f-body); color: var(--ink); }
.btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }
.btn:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }
.btn.pink { background: var(--bubblegum); }
.btn.blue { background: var(--cobalt); color: var(--paper); }
.btn.lime { background: var(--lime); }

.badge { position: absolute; z-index: 3; width: 150px; height: 150px; right: 5%; top: 300px; border-radius: 50%; background: var(--tangerine); border: 2.5px solid var(--ink); display: grid; place-items: center; text-align: center; transform: rotate(12deg); box-shadow: 5px 5px 0 var(--ink); }
.badge span { font-family: var(--f-display); font-size: 22px; line-height: 1; color: var(--paper); }
.badge::after { content: "✳"; position: absolute; top: -18px; right: -6px; font-size: 44px; color: var(--cobalt); animation: spin 9s linear infinite; }
.tag-ist { position: absolute; z-index: 3; right: 36%; bottom: 44px; background: var(--paper); border: 2px dashed var(--ink); padding: 8px 14px; transform: rotate(-7deg); }
.hint { position: absolute; right: 4%; bottom: 36px; font-family: var(--f-hand); font-size: 22px; transform: rotate(3deg); }
@media (max-width: 899px) {
  .badge { position: relative; right: auto; top: auto; width: 116px; height: 116px; margin: 0 0 18px auto; }
  .badge span { font-size: 18px; }
  .tag-ist, .hint { display: none; }
  .hero { padding-block: 16px 56px; }
}
.pop { position: absolute; pointer-events: none; z-index: 1; font-size: 34px; line-height: 1; animation: pop 0.45s cubic-bezier(.3,1.7,.5,1) both; }
@keyframes pop { from { transform: scale(0) rotate(-90deg); } to { transform: scale(1) rotate(var(--r)); } }
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- şerit ---------- */
.strip { background: var(--ink); color: var(--sun); overflow: hidden; border-block: 3px solid var(--ink); transform: rotate(-1.5deg); margin-inline: -20px; position: relative; z-index: 4; }
.strip .track { display: flex; width: max-content; animation: slide 26s linear infinite; padding-block: 12px; }
.strip span { font-family: var(--f-stamp); font-size: 18px; white-space: nowrap; padding-right: 28px; }
.strip span:nth-child(3n+2) { color: var(--bubblegum); } .strip span:nth-child(3n) { color: var(--lime); }
@keyframes slide { to { transform: translateX(-50%); } }

/* ---------- masa ---------- */
.desk-zone { background: var(--cobalt); background-image: radial-gradient(rgba(255,255,255,0.13) 1.5px, transparent 1.6px); background-size: 22px 22px; padding-block: 72px 80px; color: var(--paper); margin-top: -12px; }
.desk-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
.desk-head h2 { font-family: var(--f-display); font-weight: 400; font-size: clamp(40px, 6vw, 72px); line-height: 1; color: var(--sun); transform: rotate(-2deg); }
.desk-head p { max-width: 26em; color: #E6E9FF; }
.desk-tools { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
.desk { position: relative; margin-top: 36px; display: flex; flex-direction: column; gap: 32px; color: var(--ink); }
.obj { position: relative; width: 100%; max-width: 420px; transform: rotate(var(--r, 0deg)); touch-action: auto; }
.obj:nth-child(even) { align-self: flex-end; }
@media (min-width: 900px) {
  .desk { display: block; height: 990px; }
  .obj { position: absolute; left: var(--x); top: var(--y); width: var(--w); max-width: none; transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--r, 0deg)); cursor: grab; touch-action: none; transition: box-shadow 0.15s; }
  .obj.dragging { cursor: grabbing; transition: none; }
  .obj.dragging > .face { box-shadow: 16px 18px 0 rgba(10,10,40,0.45); }
  .obj.settle { transition: transform 0.6s cubic-bezier(.3,1.4,.5,1); }
}
.face { position: relative; box-shadow: 8px 9px 0 rgba(10,10,40,0.35); }
.tape { position: absolute; top: -14px; left: 50%; width: 110px; height: 28px; margin-left: -55px; background: rgba(255,240,160,0.75); transform: rotate(-4deg); border-left: 2px dotted rgba(0,0,0,0.12); border-right: 2px dotted rgba(0,0,0,0.12); z-index: 2; }
.obj-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 800; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }
.q { font-family: var(--f-hand); font-size: 25px; line-height: 1.1; }

/* fiş */
.receipt .face { background: #FFFFFF; padding: 26px 22px 40px; font-family: var(--f-mono); font-size: 13px; line-height: 1.6; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), 95% 100%, 90% calc(100% - 12px), 85% 100%, 80% calc(100% - 12px), 75% 100%, 70% calc(100% - 12px), 65% 100%, 60% calc(100% - 12px), 55% 100%, 50% calc(100% - 12px), 45% 100%, 40% calc(100% - 12px), 35% 100%, 30% calc(100% - 12px), 25% 100%, 20% calc(100% - 12px), 15% 100%, 10% calc(100% - 12px), 5% 100%, 0 calc(100% - 12px)); box-shadow: none; filter: drop-shadow(8px 9px 0 rgba(10,10,40,0.35)); }
.receipt h3 { font-family: var(--f-stamp); font-weight: 400; font-size: 22px; text-align: center; }
.receipt .sub { text-align: center; color: #555; }
.receipt .rule { border-top: 2px dashed var(--ink); margin: 12px 0; }
.row { display: flex; justify-content: space-between; gap: 10px; font-variant-numeric: tabular-nums; }
.row b { font-weight: 500; }
.row .plus { color: #D9411E; font-weight: 500; }
.row s { color: #777; }
.receipt .total { font-weight: 700; font-size: 15px; }
.receipt .q { margin-top: 12px; color: var(--cobalt); }

/* oyun kutusu */
.box .face { background: var(--tangerine); border: 3px solid var(--ink); border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 12px; overflow: hidden; }
.box .face::before { content: ""; position: absolute; inset: auto -40px -60px auto; width: 200px; height: 200px; border-radius: 50%; background: var(--sun); opacity: 0.9; }
.box h3 { font-family: var(--f-display); font-weight: 400; font-size: 46px; line-height: 0.9; color: var(--paper); text-shadow: 3px 3px 0 var(--ink); position: relative; }
.box .chips { display: flex; gap: 6px; flex-wrap: wrap; position: relative; }
.box .chips span { background: var(--paper); border: 2px solid var(--ink); border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: 700; }
.box .art { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; position: relative; }
.box .art svg { width: 70px; height: 104px; flex-shrink: 0; }
.box .q { color: var(--ink); position: relative; }
.box .btn { position: relative; align-self: flex-start; background: var(--lime); }
.steam path { animation: rise 3s ease-in-out infinite; }
.steam path:nth-child(2) { animation-delay: 0.7s; }
@keyframes rise { 0%,100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-4px); } }

/* zarf */
.envelope .face { background: var(--bubblegum); border: 3px solid var(--ink); border-radius: 6px; padding: 92px 22px 24px; display: flex; flex-direction: column; gap: 12px; overflow: hidden; }
.envelope .face::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 78px; background: #FFB3D9; clip-path: polygon(0 0, 100% 0, 50% 100%); border-bottom: 3px solid var(--ink); }
.envelope .seal { position: absolute; top: 50px; left: 50%; margin-left: -24px; width: 48px; height: 48px; border-radius: 50%; background: #D7263D; border: 3px solid var(--ink); display: grid; place-items: center; color: var(--paper); font-family: var(--f-display); font-size: 22px; z-index: 2; }
.envelope h3 { font-family: var(--f-display); font-weight: 400; font-size: 34px; line-height: 1; }
.tiles { display: flex; gap: 6px; }
.tile { width: 42px; height: 46px; display: grid; place-items: center; background: var(--paper); border: 2.5px solid var(--ink); border-radius: 6px; font-family: var(--f-stamp); font-size: 18px; }
.tile.blank { background: transparent; border-style: dashed; }
.soon { display: inline-block; align-self: flex-start; background: var(--ink); color: var(--bubblegum); padding: 6px 12px; transform: rotate(-3deg); }

/* yapışkan not */
.sticky .face { background: #FFF07A; padding: 26px 22px 28px; min-height: 280px; box-shadow: 6px 10px 0 rgba(10,10,40,0.35); }
.sticky .face::after { content: ""; position: absolute; right: 0; bottom: 0; width: 34px; height: 34px; background: linear-gradient(135deg, #E8D650 50%, var(--cobalt) 50%); }
.sticky h3 { font-family: var(--f-hand); font-size: 38px; line-height: 1; }
.sticky ul { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-direction: column; gap: 10px; font-family: var(--f-hand); font-size: 23px; line-height: 1.15; }
.sticky li::before { content: "☐ "; }
.sticky li.done { text-decoration: line-through; text-decoration-color: #D7263D; text-decoration-thickness: 3px; }
.sticky li.done::before { content: "☑ "; }

/* kartvizit */
.card .face { background: var(--ink); color: var(--paper); border-radius: 10px; padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; aspect-ratio: 1.75 / 1; justify-content: space-between; max-width: 100%; }
.card h3 { font-family: var(--f-display); font-weight: 400; font-size: 40px; color: var(--lime); line-height: 1; }
.card .stamp { color: var(--mint); }

/* etiket bandı */
.dymo .face { background: transparent; box-shadow: none; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
.dymo .note { background: var(--paper); border: 2.5px solid var(--ink); border-radius: 10px; padding: 18px; box-shadow: 8px 9px 0 rgba(10,10,40,0.35); display: flex; flex-direction: column; gap: 10px; }
.dymo .note h3 { font-family: var(--f-display); font-weight: 400; font-size: 30px; line-height: 1; }
.labels { display: flex; flex-wrap: wrap; gap: 8px; }
.labels span { font-family: var(--f-stamp); font-size: 12px; text-transform: uppercase; color: #FFFFFF; padding: 6px 12px; letter-spacing: 0.08em; text-shadow: 0 1px 0 rgba(255,255,255,0.35), 0 -1px 0 rgba(0,0,0,0.5); box-shadow: 2px 3px 0 rgba(10,10,40,0.35); }
.labels span:nth-child(4n+1) { background: #D7263D; transform: rotate(-2deg); }
.labels span:nth-child(4n+2) { background: #1F1F1F; transform: rotate(1.5deg); }
.labels span:nth-child(4n+3) { background: #1E7A4E; transform: rotate(-1deg); }
.labels span:nth-child(4n) { background: #2E3FE0; transform: rotate(2.5deg); }

/* ---------- iletişim ---------- */
.contact { background: var(--bubblegum); padding-block: 80px 40px; position: relative; overflow: hidden; }
.contact h2 { font-family: var(--f-display); font-weight: 400; font-size: clamp(54px, 11vw, 150px); line-height: 0.88; }
.contact h2 .boxed { background: var(--ink); color: var(--lime); }
.contact p { margin-top: 22px; max-width: 30em; font-size: 20px; }
.contact .cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
.foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 72px; padding-top: 18px; border-top: 3px solid var(--ink); }
.foot .hand { font-size: 22px; }

.toast { position: fixed; z-index: 60; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); max-width: 300px; background: var(--ink); color: var(--sun); border: 3px solid var(--sun); padding: 16px 18px; font-weight: 700; transform: rotate(-2deg); box-shadow: 6px 6px 0 var(--tangerine); }

@media (prefers-reduced-motion: reduce) {
  .strip .track, .badge::after, .steam path { animation: none; }
  .pop { animation: none; transform: rotate(var(--r)); }
  .hero h1 .l, .obj.settle, .btn, .nav a { transition: none; }
}
</style>

<header class="wrap top">
  <a class="logo" href="#">sinan<span class="c3">!</span></a>
  <nav class="nav" aria-label="Sayfa içi">
    <a href="#masa">Masam</a>
    <a href="/now">Şu an</a>
    <a href="/guestbook">Defter</a>
    <a href="#iletisim">Selam ver</a>
  </nav>
</header>

<section class="wrap hero" id="hero" aria-label="Giriş">
  <div class="badge" aria-hidden="true"><span>fikirlere<br>açığım</span></div>
  <h1 aria-label="Hey, ben Sinan. İnternette küçük, garip, renkli şeyler yapıyorum.">
    <span aria-hidden="true">Hey, ben <span class="l c1">S</span><span class="l c2">i</span><span class="l c3">n</span><span class="l c4">a</span><span class="l c1">n</span><span class="l c2">.</span></span>
    <span class="line2" aria-hidden="true">İnternette <span class="scrawl">küçük,</span> <span class="boxed">garip,</span> <span class="c3">r</span><span class="c2">e</span><span class="c1">n</span><span class="c4">k</span><span class="c3">l</span><span class="c2">i</span> şeyler yapıyorum.</span>
  </h1>
  <p class="lead"><mark>Web uygulamaları, tarayıcı oyunları ve kimse istemese de yapmak istediğim fikirler.</mark> <mark>Hepsi aşağıda, masamın üstünde. Biraz dağınık, kusura bakma.</mark></p>
  <div class="cta">
    <a class="btn blue" href="#masa">Masama bak ↓</a>
    <a class="btn pink" href="https://instagram.com/sina.hustle">@sina.hustle ↗</a>
  </div>
  <span class="tag-ist stamp" aria-hidden="true">İstanbul · 2026</span>
  <span class="hint" aria-hidden="true">← buraya tıkla, bir şey olacak</span>
</section>

<div class="strip" aria-hidden="true">
  <div class="track">
    <span>✳ fikir</span><span>✳ prototip</span><span>✳ bozuldu</span><span>✳ düzelttim</span><span>✳ yayında</span><span>✳ çay molası</span><span>✳ yeni fikir</span><span>✳ tekrar</span>
    <span>✳ fikir</span><span>✳ prototip</span><span>✳ bozuldu</span><span>✳ düzelttim</span><span>✳ yayında</span><span>✳ çay molası</span><span>✳ yeni fikir</span><span>✳ tekrar</span>
  </div>
</div>

<section class="desk-zone" id="masa" aria-labelledby="masa-baslik">
  <div class="wrap">
    <div class="desk-head">
      <h2 id="masa-baslik">Masamın üstü</h2>
      <p>Bitmiş, yarım ve yolda olan ne varsa burada. Bilgisayardaysan kağıtları tutup sürükleyebilirsin.</p>
    </div>
    <div class="desk-tools">
      <button class="btn lime" type="button" id="shuffle">Karıştır ✳</button>
      <button class="btn" type="button" id="tidy">Topla</button>
    </div>

    <div class="desk" id="desk">
      <article class="obj receipt" style="--x: 2%; --y: 40px; --w: 300px; --r: -4deg">
        <div class="tape" aria-hidden="true"></div>
        <div class="face">
          <h3>MetrajOS</h3>
          <p class="sub">ürün · saas · mvp canlı</p>
          <div class="rule"></div>
          <div class="row"><span>REV A → REV B</span><span>örnek</span></div>
          <div class="row"><b>C30/37 beton</b><span class="plus">+8,5 m³</span></div>
          <div class="row"><b>Ø12 donatı</b><span>—</span></div>
          <div class="row"><s>Alçı sıva</s><span>SİLİNDİ</span></div>
          <div class="row"><b>Seramik kaplama</b><span class="plus">YENİ 85 m²</span></div>
          <div class="rule"></div>
          <div class="row total"><span>MALİYET ETKİSİ</span><span>GÖRÜNÜR ✓</span></div>
          <p class="q">İki metraj revizyonu arasında ne değişti, maliyete nasıl yansıdı?</p>
          <p style="margin-top:8px">İki Excel'i karşılaştırır. Eklenen, silinen, değişen satırları işaretler.</p>
          <a class="obj-link" href="https://metrajos.vercel.app/">Siteyi dene ↗</a>
          <p class="sub" style="margin-top:6px">Next.js · TypeScript · Supabase</p>
        </div>
      </article>

      <article class="obj box" style="--x: 31%; --y: 10px; --w: 360px; --r: 3deg">
        <div class="face">
          <span class="stamp">oyun · oynanabilir</span>
          <h3>Mola<br>Oyunları</h3>
