---
// Ana sayfa: gece, yağmurlu pencere önünde masa. Masadaki her nesne bir proje; dokununca içerik CRT monitörde açılır.
// Sahne ve içerik: src/scripts/desk.js (ITEMS listesi dosyanın başında)
const title = 'Sinan Kurt — Masam';
const description = 'Gece, yağmurlu bir pencerenin önünde masam. Masadaki her nesne bir proje: dokun, monitörde açılsın.';
const ogImage = new URL('/og-image.png', Astro.site).toString();
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#0C0A12"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=VT323&display=swap"/>
</head>
<body>
<style is:global>
/* Layout: tam ekran 3D sahne (gece, yağmurlu pencere önünde masa). Nesneye dokununca kamera CRT monitöre yaklaşır, içerik ekranın üstüne hizalanmış HTML olarak açılır. Altta düz liste. */
:root {
  --night: #0C0A12;
  --ink: #F1E9DC;
  --muted: #A99FB2;
  --line: rgba(241, 233, 220, 0.14);
  --amber: #FFB347;
  --amber-dim: #B87A2E;
  --crt: #0B0703;
  --f-ui: "Bricolage Grotesque", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-crt: "VT323", "IBM Plex Mono", ui-monospace, Menlo, monospace;
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { margin: 0; background: var(--night); color: var(--ink); font-family: var(--f-ui); overflow-x: clip; }
a { color: inherit; }
button { font: inherit; color: inherit; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 6px; }
h1, h2, p { margin: 0; }

#app { display: flex; flex-direction: column; min-height: 100vh; }
.stage { position: relative; height: 100vh; min-height: 520px; overflow: hidden; background: var(--night); }
#gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }

.bar { position: absolute; z-index: 20; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; padding: 14px 16px; pointer-events: none; }
@media (min-width: 760px) { .bar { padding: 20px 28px; } }
.bar > * { pointer-events: auto; }
.name { display: flex; flex-direction: column; text-decoration: none; line-height: 1.15; }
.name b { font-size: 17px; letter-spacing: -0.01em; }
.name span { font-size: 13px; color: var(--muted); }
.bar nav { display: flex; gap: 2px 16px; flex-wrap: wrap; align-items: center; font-size: 14px; color: var(--muted); }
.bar nav a, .bar nav button { min-height: 40px; display: inline-flex; align-items: center; text-decoration: none; background: none; border: 0; padding: 0; cursor: pointer; color: inherit; }
.bar nav a:hover, .bar nav button:hover { color: var(--ink); }
.bar nav button[aria-pressed="true"] { color: var(--amber); }
.bar { transition: opacity 0.3s; }
.is-focus .bar { opacity: 0; pointer-events: none; }
.is-focus .bar > * { pointer-events: none; }
@media (max-width: 520px) { .bar nav { font-size: 13px; gap: 0 12px; } .name span { display: none; } }

.hint { position: absolute; z-index: 15; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 96px 16px 18px; pointer-events: none; transition: opacity 0.4s; background: linear-gradient(to top, rgba(12, 10, 18, 0.94), rgba(12, 10, 18, 0.86) 62%, transparent); }
.hint > * { pointer-events: auto; }
.hint p { font-size: 14px; color: var(--muted); text-align: center; }
.hint .lede { font-size: clamp(16px, 2.2vw, 19px); font-weight: 600; color: var(--ink); max-width: 30ch; line-height: 1.35; text-wrap: balance; text-shadow: 0 1px 12px rgba(12, 10, 18, 0.9); }
.hint p b { color: var(--ink); font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; max-width: 760px; }
/* geniş ekranda alt alan alçak: cümle tek satır, çipler tek sıra, karartma kısa; masa ve klavye örtülmez */
@media (min-width: 900px) and (min-aspect-ratio: 5/4) {
  .hint { gap: 8px; padding: 44px 24px 14px; background: linear-gradient(to top, rgba(12, 10, 18, 0.92), rgba(12, 10, 18, 0.7) 55%, transparent); }
  .hint .lede { max-width: none; font-size: 17px; }
  .chips { max-width: 1100px; }
}
.chips button { min-height: 36px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line); background: rgba(12, 10, 18, 0.55); backdrop-filter: blur(6px); font-size: 13px; cursor: pointer; color: var(--ink); }
.chips button span { color: var(--muted); margin-left: 6px; }
.chips button:hover { border-color: var(--amber); }
.is-focus .hint { opacity: 0; pointer-events: none; }
.is-focus .hint > * { pointer-events: none; }
.list-link { font-size: 13px; color: var(--muted); }

.tip { position: absolute; z-index: 16; left: 0; top: 0; pointer-events: none; display: flex; flex-direction: column; gap: 1px; padding: 8px 12px; border-radius: 10px; background: rgba(12, 10, 18, 0.82); border: 1px solid var(--line); backdrop-filter: blur(6px); white-space: nowrap; }
.tip strong { font-size: 14px; font-weight: 600; }
.tip span { font-family: var(--f-crt); font-size: 18px; line-height: 1; color: var(--amber); }

/* monitör ekranındaki içerik */
.screen { position: absolute; z-index: 18; overflow: hidden; border-radius: 18px / 22px; background: radial-gradient(120% 120% at 50% 45%, #1E1306, var(--crt) 75%); color: var(--amber); font-family: var(--f-crt); opacity: 0; transition: opacity 0.35s; box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.75), 0 0 40px rgba(255, 170, 60, 0.12); }
.screen.on { opacity: 1; }
.screen::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.14) 0 2px, transparent 2px 4px); border-radius: inherit; }
.screen-body { position: absolute; inset: 0; overflow: auto; overscroll-behavior: contain; padding: 1.1em 1.4em 1.3em; display: flex; flex-direction: column; gap: 0.55em; text-shadow: 0 0 8px rgba(255, 170, 60, 0.55); scrollbar-color: var(--amber-dim) transparent; }
.scr-cmd { opacity: 0.6; font-size: 1em; }
.scr-kind { font-size: 1em; color: var(--amber-dim); text-transform: uppercase; letter-spacing: 0.06em; }
.scr-title { font-family: var(--f-crt); font-weight: 400; font-size: 3em; line-height: 0.9; }
/* okunacak metin: atmosfer başlıkta kalır, paragraflar temiz fontla */
.scr-q { font-family: var(--f-ui); font-weight: 600; font-size: clamp(17px, 0.82em, 22px); line-height: 1.35; color: #FFD39A; text-shadow: none; max-width: 38em; text-wrap: pretty; }
.scr-desc { font-family: var(--f-ui); font-weight: 400; font-size: clamp(15px, 0.7em, 18px); line-height: 1.6; color: #F1DDBF; text-shadow: none; max-width: 38em; text-wrap: pretty; }
.scr-stack { font-size: 1em; opacity: 0.6; }
.scr-links { display: flex; flex-wrap: wrap; gap: 0.5em 1em; margin-top: 0.3em; }
.scr-link { font-size: 1.25em; white-space: nowrap; max-width: 100%; min-height: 40px; display: inline-flex; align-items: center; padding: 0 0.5em; border: 1px solid var(--amber-dim); text-decoration: none; }
.scr-link.primary { background: var(--amber); color: var(--crt); text-shadow: none; border-color: var(--amber); }
.scr-link:hover { background: rgba(255, 179, 71, 0.15); }
.scr-link.primary:hover { background: #FFC873; }
.screen-body { padding-bottom: max(1.3em, 76px); }
.scr-object { margin-top: auto; padding-top: 0.6em; opacity: 0.45; font-size: 0.95em; }

.back { position: absolute; z-index: 21; left: 16px; bottom: 16px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--line); background: rgba(12, 10, 18, 0.7); backdrop-filter: blur(6px); cursor: pointer; font-weight: 600; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
@media (min-width: 760px) { .back { left: 28px; bottom: 24px; } }
.is-focus .back { opacity: 1; pointer-events: auto; }
/* dar ekran: düğme monitörün üstünde, içerikle çakışmaz */
.is-narrow .back { top: calc(10px + env(safe-area-inset-top, 0px)); bottom: auto; left: 12px; min-height: 42px; }
.is-narrow .screen-body { padding-bottom: 1.3em; position: relative; inset: auto; max-height: inherit; }
.is-narrow .scr-object { margin-top: 0.4em; }
.is-narrow .scr-link { font-size: 1.1em; }
/* proje açıkken sayfa kaymaz; tek kaydırma alanı monitör */
html.scroll-lock, html.scroll-lock body { overflow: hidden; }
.back:hover { border-color: var(--amber); }

.toast { position: absolute; z-index: 30; left: 50%; top: 76px; transform: translateX(-50%); max-width: calc(100% - 32px); padding: 10px 16px; border-radius: 999px; background: rgba(12, 10, 18, 0.85); border: 1px solid var(--line); font-size: 14px; }

/* düz liste */
.list { border-top: 1px solid var(--line); padding: 56px 16px 40px; background: var(--night); }
@media (min-width: 760px) { .list { padding: 72px 28px 48px; } }
.list-inner { max-width: 1100px; margin: 0 auto; }
.list .eyebrow { font-family: var(--f-crt); font-size: 20px; color: var(--amber); }
.list h2 { font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -0.03em; margin-top: 4px; }
.list ul { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 0 32px; }
.list li { border-top: 1px solid var(--line); padding: 18px 0; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.list .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.list h3 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }
.list .obj { font-family: var(--f-crt); font-size: 18px; color: var(--amber); white-space: nowrap; }
.list li p { color: var(--muted); line-height: 1.5; }
.list li a { align-self: flex-start; min-height: 40px; display: inline-flex; align-items: center; font-weight: 600; text-underline-offset: 4px; }
.foot { max-width: 1100px; margin: 48px auto 0; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }

.no-gl .stage { height: auto; min-height: 0; padding: 96px 16px 24px; }
.no-gl #gl, .no-gl .chips, .no-gl .tip, .no-gl .back { display: none; }
.no-gl .hint { position: static; }
@media (prefers-reduced-motion: reduce) { .screen, .hint, .back { transition: none; } }
</style>

<div id="app" data-base="">
  <main class="stage" id="stage">
    <canvas id="gl" aria-label="Gece, yağmurlu bir pencerenin önünde Sinan'ın masası. Masadaki nesneler projeleri temsil ediyor." role="img"></canvas>

    <header class="bar">
      <a class="name" href="/"><b>Sinan Kurt</b><span>İstanbul · web, oyun, girişim</span></a>
      <nav aria-label="Bağlantılar">
        <button type="button" data-open="monitor">Hakkımda</button>
        <a href="/guestbook">Defter</a>
        <a href="https://instagram.com/sina.hustle">Instagram ↗</a>
        <button type="button" id="sound" aria-pressed="false">Yağmur: kapalı</button>
      </nav>
    </header>

    <div class="tip" id="tip" hidden></div>

    <div class="screen" id="screen" hidden>
      <div class="screen-body" id="screenBody" aria-live="polite"></div>
    </div>
    <button class="back" id="back" type="button">← Masaya dön</button>

    <div class="hint" id="hint">
      <p class="lede">İnternette küçük, kullanışlı ya da sadece eğlenceli şeyler yapıyorum.</p>
      <p><b>Masadaki bir şeye dokun.</b> Her nesne bir proje.</p>
      <div class="chips" role="group" aria-label="Masadaki nesneler">
        <button type="button" data-open="envelope">Zarf<span>Sevgili Bulmacası</span></button>
        <button type="button" data-open="jar">Kavanoz<span>Bir Şey</span></button>
        <button type="button" data-open="tea">Çay bardağı<span>Mola Oyunları</span></button>
        <button type="button" data-open="hat">Baret<span>MetrajOS</span></button>
        <button type="button" data-open="camera">Fotoğraf makinesi<span>Offra Studio</span></button>
        <button type="button" data-open="bulb">Ampul<span>Sıradaki fikir</span></button>
      </div>
      <a class="list-link" href="#liste">ya da düz liste ↓</a>
    </div>

    <p class="toast" id="toast" role="status" aria-live="polite" hidden></p>
  </main>

  <section class="list" id="liste" aria-labelledby="liste-baslik">
    <div class="list-inner">
      <p class="eyebrow">C:\SINAN&gt; dir</p>
      <h2 id="liste-baslik">Masadaki her şey</h2>
      <ul>
        <li>
          <div class="row"><h3>MetrajOS</h3><span class="obj">baret</span></div>
          <p>İki metraj revizyonunu karşılaştırıp maliyet etkisini gösteren SaaS. MVP canlı.</p>
          <a href="https://metrajos.vercel.app/">Siteyi dene ↗</a>
        </li>
        <li>
          <div class="row"><h3>Mola Oyunları</h3><span class="obj">çay bardağı</span></div>
          <p>Çay ocağı, dolmuş durağı gibi gündelik sahnelerden kısa tarayıcı oyunları.</p>
          <a href="https://sinan-kurt.github.io/herdilabs-play/">Hemen oyna ↗</a>
        </li>
        <li>
          <div class="row"><h3>Sevgili Bulmacası</h3><span class="obj">zarf</span></div>
          <p>Sevdiğin birine mesaj yerine kişisel bir bulmaca gönder. Çözünce senin mesajın açılıyor.</p>
          <a href="https://sevgili.netlify.app/">Bir bulmaca hazırla ↗</a>
        </li>
        <li>
          <div class="row"><h3>Bir Şey</h3><span class="obj">kavanoz</span></div>
          <p>Birine anılarla dolu küçük bir dünya hazırla: anı kavanozu, minik gezegen ya da müzik kutusu. O dokundukça keşfediyor.</p>
          <a href="https://bir-sey.netlify.app/">Bir şey hazırla ↗</a>
        </li>
        <li>
          <div class="row"><h3>Offra Studio</h3><span class="obj">fotoğraf makinesi</span></div>
          <p>Kurucu ortağı olduğum yaratıcı stüdyo: kimlik, strateji, dijital deneyim.</p>
          <a href="/projects/offra-studio/">Proje sayfası ↗</a>
        </li>
      </ul>
      <footer class="foot">
        <span>© 2026 Sinan Kurt</span>
        <span>gece yarısı, yağmur yağarken yapıldı</span>
      </footer>
    </div>
  </section>
</div>

<script>
import '../scripts/desk.js';
</script>
</body>
</html>
