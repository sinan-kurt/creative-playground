---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const ogImage = new URL('/og-image.png', Astro.site).toString();
const { title='Sinan Kurt — Creative Playground', description='Web uygulamaları, küçük oyunlar ve dijital deneyimler.' } = Astro.props;
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f6f3ec"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><Header/><main><slot/></main><Footer/><script>document.addEventListener('keydown',(e)=>{const seq=['s','i','n','a','n'];const w=window as Window & { __secretIndex?:number };if(e.key.toLowerCase()===seq[w.__secretIndex||0]){w.__secretIndex=(w.__secretIndex||0)+1;if(w.__secretIndex===seq.length){w.__secretIndex=0;document.dispatchEvent(new CustomEvent('playground:secret'));}}else{w.__secretIndex=0;}});</script></body></html>